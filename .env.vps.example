# Copy to .env on the VPS (chmod 600). This file is a template; leave secrets empty.
# `docker compose` reads .env for ${...} substitution. COMPOSE_FILE makes the
# production file the default so a plain `docker compose up` cannot start the dev stack.
COMPOSE_FILE=docker-compose.prod.yml
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# Generated on the server. Do not reuse the local dev SA password.
MSSQL_SA_PASSWORD=
APP_DB_PASSWORD=

# AdminSeeder creates this account only when the Users table is empty.
ADMIN_EMAIL=admin@tugceaydincignakli.com
ADMIN_PASSWORD=

# At least 32 characters.
JWT_KEY=

FRONTEND_ORIGIN=https://tugceaydincignakli.com
ALLOWED_HOSTS=api;localhost;127.0.0.1

# true only when the frontend build has a reCAPTCHA site key. If true, set the secret.
RECAPTCHA_ENABLED=
RECAPTCHA_SECRET_KEY=

# Same value as INTERNAL_API_KEY in the frontend .env.
INTERNAL_API_KEY=

# Static address of the frontend container on the tacdent network.
TRUSTED_PROXY_IP=172.30.0.10
TACDENT_SUBNET=172.30.0.0/16

API_PORT=8082
MSSQL_PORT=1433
